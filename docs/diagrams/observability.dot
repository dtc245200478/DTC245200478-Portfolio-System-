digraph Observability {
graph [rankdir=TB,bgcolor="white",pad="0.25",nodesep="0.35",ranksep="0.5",fontname="Arial",fontsize=17,label="LINK ME   GIÁM SÁT VÀ LOG TẬP TRUNG",labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#EFF3E9",color="#7B8D6F",fontname="Arial",fontsize=14,margin="0.18,0.12"];edge [fontname="Arial",fontsize=12,color="#59694F",penwidth=1.3];
grafana [label="Grafana\nlocalhost:3004"];
prom [label="Prometheus\nScrape 15 giây   Giữ 7 ngày"];
app [label="Ứng dụng\n/metrics"];
nginx [label="Nginx exporter\nĐọc stub_status"];
mysql [label="MySQL exporter\nĐọc số liệu database"];
cadvisor [label="cAdvisor\nCPU RAM container từ host"];
loki [label="Loki\nLưu và truy vấn log 7 ngày"];
promtail [label="Promtail\nĐọc file và lưu vị trí đọc"];
logs [label="Named volume log\nApp JSON   Nginx JSON   MySQL",shape=folder];
grafana -> prom [label="HTTP PromQL"];
grafana -> loki [label="HTTP LogQL"];
prom -> app [label="HTTP scrape"];
prom -> nginx [label="HTTP scrape"];
prom -> mysql [label="HTTP scrape"];
prom -> cadvisor [label="HTTP scrape"];
logs -> promtail [label="Nội dung file chỉ đọc"];
promtail -> loki [label="HTTP push log"];
}
