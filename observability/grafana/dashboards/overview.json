    },
    {
      "id": 8,
      "title": "Độ trễ API p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(linkme_http_duration_seconds_bucket[5m])))",
